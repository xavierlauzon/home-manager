# Komodo CLI config - https://komo.do/docs/ecosystem/cli
#
# This file documents the DECRYPTED content of the sops-encrypted
#   komodo.cli.toml.enc  (deployed to ~/.config/komodo/komodo.cli.toml)
#
# To edit the real (encrypted) config for this user, run from the repo root:
#   sops home/xl/user/xavier/secrets/komodo/komodo.cli.toml.enc
#
# To create a fresh encrypted file from a plaintext copy:
#   sops -e home/xl/user/xavier/secrets/komodo/komodo.cli.toml \
#     > home/xl/user/xavier/secrets/komodo/komodo.cli.toml.enc

default_profile = "Default"

[[profile]]
name = "Default"
aliases = ["d"]                 # use: km -p d ...
host = "https://komodo.lauzon.xyz"   # TODO: your Komodo Core URL
key = "K-REPLACE-ME"            # TODO: your Core API key
secret = "S-REPLACE-ME"         # TODO: your Core API secret

# Optional: database settings used by `km db backup/restore`
# database.address = "localhost:27017"
# database.username = ""
# database.password = ""
# database.db_name = "komodo"
