# Komodo CLI config - https://komo.do/docs/ecosystem/cli
#
# Staged config for sam: the encrypted komodo.cli.toml.enc does not exist
# yet, so this secret is NOT active. To activate:
#   1. Add sam's age public key to .sops.yaml (rule: home/xl/user/sam/secrets/.*)
#   2. Create the encrypted file (see example below), e.g.:
#        sops home/xl/user/sam/secrets/komodo/komodo.cli.toml.enc   # after creating a plaintext file
#   3. Ensure `user.sam.secrets.komodo.enable = true;` is set in
#      home/xl/hostname/blackhawk/default.nix

default_profile = "Default"

[[profile]]
name = "Default"
aliases = ["d"]                 # use: km -p d ...
host = "https://komodo.lauzon.xyz"   # TODO: your Komodo Core URL
key = "K-REPLACE-ME"            # TODO: your Core API key
secret = "S-REPLACE-ME"         # TODO: your Core API secret
